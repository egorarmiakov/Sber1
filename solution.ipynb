   "source": [
    "# AI-ассистент для классификации ошибок в математике\n",
    "\n",
    "Модель определяет первоисточник ошибки ученика (классы 0–4).\n",
    "Архитектура: Fine-tuning ruT5-base.\n",
    "Метрика: F1-macro."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import re\n",
    "from sklearn.metrics import f1_score\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification, TrainingArguments, Trainer\n",
    "from datasets import Dataset\n",
    "\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def normalize_latex(text):\n",
    "    if not isinstance(text, str):\n",
    "        return \"\"\n",
    "    text = re.sub(r'\\\\frac\\{([^{}]*)\\}\\{([^{}]*)\\}', r'[FRAC] \\1 over \\2', text)\n",
    "    text = re.sub(r'\\^\\{([^{}]*)\\}', r' to the power of \\1', text)\n",
    "    text = re.sub(r'_\\{([^{}]*)\\}', r' subscript \\1', text)\n",
    "    text = re.sub(r'\\\\sqrt\\{([^{}]*)\\}', r'square root of \\1', text)\n",
    "    text = re.sub(r'\\\$$a-zA-Z]+', '', text)\n",
    "    text = text.replace('{', ' ').replace('}', ' ')\n",
    "    text = text.replace(',', '.')\n",
    "    return text.lower().strip()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def prepare_input(question, steps):\n",
    "    clean_q = question.lower().strip()\n",
    "    clean_s = normalize_latex(steps).strip()\n",
    "    return f\"[QUESTION] {clean_q} [SEP] {clean_s}\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "train_df = pd.read_csv('train.csv')\n",
    "test_df = pd.read_csv('test.csv')\n",
    "print(train_df['error_category'].value_counts())\n",
    "train_texts = train_df.apply(lambda row: prepare_input(row['question'], row['steps']), axis=1)\n",
    "test_texts = test_df.apply(lambda row: prepare_input(row['question'], row['steps']), axis=1)\n",
    "train_labels = train_df['error_category'].values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "MODEL_NAME = \"ai-forever/ruT5-base\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
    "\n",
    "def tokenize_function(examples):\n",
    "    return tokenizer(examples[\"text\"], padding=\"max_length\", truncation=True, max_length=512)\n",
    "\n",
    "train_dataset = Dataset.from_dict({\"text\": train_texts, \"label\": train_labels})\n",
    "test_dataset = Dataset.from_dict({\"text\": test_texts})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "kf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
    "f1_scores = []\n",
    "\n",
    "for fold, (train_idx, val_idx) in enumerate(kf.split(train_texts, train_labels)):\n",
    "    print(f\"--- FOLD {fold+1}/5 ---\")\n",
    "    model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=5)\n",
    "    \n",
    "    train_encodings = tokenizer(list(train_texts.iloc[train_idx]), truncation=True, padding=True, max_length=512)\n",
    "    val_encodings = tokenizer(list(train_texts.iloc[val_idx]), truncation=True, padding=True, max_length=512)\n",
    "    \n",
    "    def compute_metrics(p):\n",
    "        preds = p.predictions.argmax(-1)\n",
    "        return {'f1_macro': f1_score(p.label_ids, preds, average='macro')}\n",
    "    \n",
    "    training_args = TrainingArguments(\n",
