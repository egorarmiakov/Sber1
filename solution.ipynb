{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# AI-ассистент для классификации ошибок в математике\n",
    "\n",
    "Модель определяет первоисточник ошибки ученика (классы 0–4).\n",
    "Архитектура: Fine-tuning ruT5-base.\n",
    "Метрика: F1-macro."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import re\n",
    "from sklearn.metrics import f1_score\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification, TrainingArguments, Trainer\n",
    "from datasets import Dataset\n",
    "\n",
    "# Настройка детерминированности\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Функция нормализации LaTeX формул\n",
    "def normalize_latex(text):\n",
    "    if not isinstance(text, str):\n",
    "        return \"\"\n",
    "    \n",
    "    # Замена дробей \\frac{a}{b}\n",
    "    text = re.sub(r'\\\\frac\\{([^{}]*)\\}\\{([^{}]*)\\}', r'[FRAC] \\1 over \\2', text)\n",
    "    # Замена степеней ^{...}\n",
    "    text = re.sub(r'\\^\\{([^{}]*)\\}', r' to the power of \\1', text)\n",
    "    # Индексы _{...}\n",
    "    text = re.sub(r'_\\{([^{}]*)\\}', r' subscript \\1', text)\n",
    "    # Корни \\sqrt{...}\n",
    "    text = re.sub(r'\\\\sqrt\\{([^{}]*)\\}', r'square root of \\1', text)\n",
    "    # Удаление оставшихся команд бекслеша (оставляем только буквы/цифры внутри)\n",
    "    text = re.sub(r'\\\$$a-zA-Z]+', '', text)\n",
    "    # Убираем лишние фигурные скобки\n",
    "    text = text.replace('{', ' ').replace('}', ' ')\n",
    "    # Стандартизация чисел (запятые -> точки)\n",
    "    text = text.replace(',', '.')\n",
    "    return text.lower().strip()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Подготовка входного текста (Контекст + Решение)\n",
    "def prepare_input(question, steps):\n",
    "    clean_q = question.lower().strip()\n",
    "    clean_s = normalize_latex(steps).strip()\n",
    "    # [SEP] помогает модели разделить условие и само решение\n",
    "    return f\"[QUESTION] {clean_q} [SEP] {clean_s}\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Загрузка данных\n",
    "train_df = pd.read_csv('train.csv')\n",
    "test_df = pd.read_csv('test.csv')\n",
    "\n",
    "# Проверка баланса классов\n",
    "print(train_df['error_category'].value_counts())\n",
    "\n",
    "# Применение подготовки текста\n",
    "train_texts = train_df.apply(lambda row: prepare_input(row['question'], row['steps']), axis=1)\n",
    "test_texts = test_df.apply(lambda row: prepare_input(row['question'], row['steps']), axis=1)\n",
    "\n",
    "train_labels = train_df['error_category'].values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Выбор компактной модели из-за малого объема данных (293 примера)\n",
    "MODEL_NAME = \"ai-forever/ruT5-base\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
    "\n",
    "def tokenize_function(examples):\n",
    "    return tokenizer(examples[\"text\"], padding=\"max_length\", truncation=True, max_length=512)\n",
    "\n",
    "# Создание датасетов HuggingFace\n",
    "train_dataset = Dataset.from_dict({\"text\": train_texts, \"label\": train_labels})\n",
    "test_dataset = Dataset.from_dict({\"text\": test_texts})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- БЛОК ОЦЕНКИ (КРОСС-ВАЛИДАЦИЯ) ---\n",
    "# На реальных соревнованиях это делается через CV Leaderboard. Здесь реплицируем логику.\n",
    "\n",
    "kf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
    "f1_scores = []\n",
    "\n",
    "for fold, (train_idx, val_idx) in enumerate(kf.split(train_texts, train_labels)):\n",
    "    print(f\"--- FOLD {fold+1}/5 ---\")\n",
    "    \n",
    "    model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=5)\n",
    "    \n",
    "    train_encodings = tokenizer(list(train_texts.iloc[train_idx]), truncation=True, padding=True, max_length=512)\n",
    "    val_encodings = tokenizer(list(train_texts.iloc[val_idx]), truncation=True, padding=True, max_length=512)\n",
    "    \n",
    "    def compute_metrics(p):\n",
    "        preds = p.predictions.argmax(-1)\n",
    "        return {'f1_macro': f1_score(p.label_ids, preds, average='macro')}\n",
    "    \n",
    "    training_args = TrainingArguments(\n",
    "        output_dir=f'./results_fold_{fold}',\n",
    "        num_train_epochs=6,\n",
    "        per_device_train_batch_size=4,\n",
    "        per_device_eval_batch_size=8,\n",
    "        warmup_steps=50,\n",
    "        weight_decay=0.01,\n",
    "        logging_dir=f'./logs_fold_{fold}',\n",
    "        evaluation_strategy=\"epoch\",\n",
    "        save_strategy=\"epoch\",\n",
    "        load_best_model_at_end=True,\n",
    "        metric_for_best_model=\"f1_macro\",\n",
    "        greater_is_better=True,\n",
    "        seed=SEED\n",
    "    )\n",
    "    \n",
    "    trainer = Trainer(\n",
    "        model=model,\n",
    "        args=training_args,\n",
    "        train_dataset=Dataset.from_dict(train_encodings),\n",
    "        eval_dataset=Dataset.from_dict(val_encodings),\n",
    "        compute_metrics=compute_metrics,\n",
    "    )\n",
    "    \n",
    "    trainer.train()\n",
    "    result = trainer.evaluate()\n",
    "    f1_scores.append(result['eval_f1_macro'])\n",
    "    print(f\"Fold {fold+1} Macro-F1: {result['eval_f1_macro']:.4f}\")\n",
    "\n",
    "print(f\"\\nCV Mean F1-macro: {np.mean(f1_scores):.4f} (+/- {np.std(f1_scores):.4f})\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- БЛОК ФИНАЛЬНОГО ОБУЧЕНИЯ НА ВСЕХ ДАННЫХ ---\n",
    "final_model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=5)\n",
    "\n",
    "final_training_args = TrainingArguments(\n",
    "    output_dir=\"./final_model\",\n",
    "    num_train_epochs=8,\n",
    "    per_device_train_batch_size=4,\n",
    "    learning_rate=3e-5,\n",
    "    warmup_steps=100,\n",
    "    weight_decay=0.01,\n",
    "    logging_steps=10,\n",
    "    seed=SEED\n",
    ")\n",
    "\n",
    "full_train_encodings = tokenizer(list(train_texts), truncation=True, padding=True, max_length=512)\n",
    "\n",
    "final_trainer = Trainer(\n",
    "    model=final_model,\n",
    "    args=final_training_args,\n",
    "    train_dataset=Dataset.from_dict(full_train_encodings),\n",
    ")\n",
    "\n",
    "final_trainer.train()\n",
    "final_trainer.save_model(\"./final_model\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- ГЕНЕРАЦИЯ SUBMISSION ---\n",
    "test_encodings = tokenizer(list(test_texts), truncation=True, padding=True, max_length=512)\n",
    "test_dataset_enc = Dataset.from_dict(test_encodings)\n",
    "\n",
    "predictions = final_trainer.predict(test_dataset_enc).predictions\n",
    "predicted_classes = np.argmax(predictions, axis=1)\n",
    "\n",
    "submission = pd.DataFrame({\n",
    "    'question_id': test_df['question_id'],\n",
    "    'error_category': predicted_classes\n",
    "})\n",
    "\n",
    "submission.to_csv('submission.csv', index=False)\n",
    "print(\"Файл submission.csv успешно создан.\")\n",
    "print(submission.head())"
   ]
  }
 ],
