import pandas as pd
import numpy as np
import torch
from torch.utils.data import Dataset, DataLoader
from transformers import AutoTokenizer, AutoModel, AdamW, get_linear_schedule_with_warmup
from sklearn.model_selection import train_test_split
from sklearn.metrics import f1_score
from sklearn.feature_extraction.text import TfidfVectorizer
import re

# Загрузка данных (пути нужно заменить)
train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

def clean_latex(text):
    # Защита формул
    def wrap_formula(match):
        content = match.group(1).strip()
        # Нормализация пробелов внутри формулы
        content = re.sub(r'\s+', ' ', content)
        return f"<formula>{content}</formula>"
    
    text = re.sub(r'\$(.*?)\$', wrap_formula, text)
    text = re.sub(r'\\$$(.*?)\\$$', wrap_formula, text, flags=re.DOTALL)
    text = re.sub(r'\\$(.*?)\\$', wrap_formula, text, flags=re.DOTALL)
    return text.strip()

def extract_meta_features(question, final_answer):
    features = []
    # Признак 1: содержит ли финальный ответ переменные (буквы)
    has_vars = int(bool(re.search(r'[a-zA-Z]', str(final_answer))))
    features.append(has_vars)
    
    # Признак 2: длина условия (косвенный признак сложности понимания)
    q_len = len(str(question))
    features.append(q_len / 1000) # нормализация
    
    return np.array(features, dtype=np.float32)

# Применяем очистку
for df in [train_df, test_df]:
    df['clean_steps'] = df['steps'].astype(str).apply(clean_latex)
    df['meta_feats'] = df.apply(lambda row: extract_meta_features(row['question'], row['final_answer']), axis=1)

class MathErrorDataset(Dataset):
    def __init__(self, texts, meta_feats, labels=None, tokenizer=None, max_length=512):
        self.texts = texts
        self.meta_feats = meta_feats
        self.labels = labels
        self.tokenizer = tokenizer
        self.max_length = max_length
        
    def __len__(self):
        return len(self.texts)
    
    def __getitem__(self, idx):
        item = {
            'input_ids': torch.tensor(self.encodings['input_ids'][idx]),
            'attention_mask': torch.tensor(self.encodings['attention_mask'][idx])
        }
        item['meta'] = torch.tensor(self.meta_feats[idx], dtype=torch.float32)
        
        if self.labels is not None:
            item['labels'] = torch.tensor(self.labels[idx], dtype=torch.long)
            
        return item

    def set_encodings(self, encodings):
        self.encodings = encodings

class HybridMathClassifier(torch.nn.Module):
    def __init__(self, bert_name='sberbank-ai/ruBert-base', num_classes=5, meta_dim=2):
        super().__init__()
        self.bert = AutoModel.from_pretrained(bert_name)
        bert_hidden_size = self.bert.config.hidden_size
        
        # Классификатор над CLS-токеном + мета-признаками
        self.classifier = torch.nn.Sequential(
            torch.nn.Dropout(0.3),
            torch.nn.Linear(bert_hidden_size + meta_dim, 256),
            torch.nn.ReLU(),
            torch.nn.Dropout(0.2),
            torch.nn.Linear(256, num_classes)
        )

    def forward(self, input_ids, attention_mask, meta):
        outputs = self.bert(input_ids=input_ids, attention_mask=attention_mask)
        cls_emb = outputs.last_hidden_state[:, 0, :] # Берем [CLS]
        
        combined = torch.cat([cls_emb, meta], dim=1)
        logits = self.classifier(combined)
        return logits

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
tokenizer = AutoTokenizer.from_pretrained('sberbank-ai/ruBert-base')

y = train_df['error_category'].values
X_train, X_val, y_train, y_val, meta_train, meta_val = train_test_split(
    train_df['clean_steps'], y, train_df['meta_feats'].tolist(), 
    stratify=y, random_state=42, test_size=0.1
)

train_enc = tokenizer(list(X_train), padding=True, truncation=True, max_length=384, return_tensors='pt')
val_enc = tokenizer(list(X_val), padding=True, truncation=True, max_length=384, return_tensors='pt')

train_dataset = MathErrorDataset(None, meta_train, y_train, tokenizer)
train_dataset.set_encodings(train_enc)
val_dataset = MathErrorDataset(None, meta_val, y_val, tokenizer)
val_dataset.set_encodings(val_enc)

train_loader = DataLoader(train_dataset, batch_size=16, shuffle=True)
val_loader = DataLoader(val_dataset, batch_size=32)

model = HybridMathClassifier().to(device)
optimizer = AdamW(model.parameters(), lr=2e-5, weight_decay=0.01)
criterion = torch.nn.CrossEntropyLoss(weight=torch.tensor([1.5, 1.2, 1.0, 1.0, 1.3]).to(device)) # Пример взвешивания

num_epochs = 10
total_steps = len(train_loader) * num_epochs
scheduler = get_linear_schedule_with_warmup(optimizer, num_warmup_steps=int(0.1 * total_steps), num_training_steps=total_steps)

best_f1 = 0.0
for epoch in range(num_epochs):
    model.train()
    for batch in train_loader:
        optimizer.zero_grad()
        input_ids = batch['input_ids'].to(device)
        attn_mask = batch['attention_mask'].to(device)
        meta = batch['meta'].to(device)
        labels = batch['labels'].to(device)
        
        logits = model(input_ids, attn_mask, meta)
        loss = criterion(logits, labels)
        loss.backward()
        optimizer.step()
        scheduler.step()

    # Валидация
    model.eval()
    preds, truths = [], []
    with torch.no_grad():
        for batch in val_loader:
            input_ids = batch['input_ids'].to(device)
            attn_mask = batch['attention_mask'].to(device)
            meta = batch['meta'].to(device)
            labels = batch['labels'].to(device)
            
            logits = model(input_ids, attn_mask, meta)
            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())
            truths.extend(labels.cpu().numpy())
            
    current_f1 = f1_score(truths, preds, average='macro')
    print(f"Epoch {epoch+1}, Val F1-macro: {current_f1:.4f}")
    
    if current_f1 > best_f1:
        best_f1 = current_f1
        torch.save(model.state_dict(), 'best_model.pt')

# Загрузка лучшей модели
model.load_state_dict(torch.load('best_model.pt'))
model.to(device)
model.eval()

test_enc = tokenizer(test_df['clean_steps'].tolist(), padding=True, truncation=True, max_length=384, return_tensors='pt')
test_meta = np.stack(test_df['meta_feats'].values)

test_dataset = MathErrorDataset(None, test_meta, labels=None, tokenizer=None)
test_dataset.set_encodings(test_enc)
test_loader = DataLoader(test_dataset, batch_size=32)

all_predictions = []
with torch.no_grad():
    for batch in test_loader:
        input_ids = batch['input_ids'].to(device)
        attn_mask = batch['attention_mask'].to(device)
        meta = batch['meta'].to(device)
        
        logits = model(input_ids, attn_mask, meta)
        probs = torch.softmax(logits, dim=1)
        all_predictions.extend(torch.argmax(probs, dim=1).cpu().numpy())

submission = pd.DataFrame({
    'question_id': test_df['question_id'],
    'error_category': all_predictions
})

submission.to_csv('submission.csv', index=False)
print("Файл submission.csv успешно сохранен.")
